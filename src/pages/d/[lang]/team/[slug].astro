---
import Person from '../../../../components/d/Person.astro';
import { LANGS } from '../../../../lib/d.js';
import items from '../../../../../content/team.json';
export function getStaticPaths() {
  return LANGS.flatMap((lang) => items.filter((x) => x.slug).map((x) => ({ params: { lang, slug: x.slug } })));
}
const { lang, slug } = Astro.params;
---
<Person lang={lang} slug={slug} />
