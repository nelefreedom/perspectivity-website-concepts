---
// Concept A in English or Dutch, built from the content files that editors change in Pages CMS.
// Every text in content/*.json holds both languages: { "en": "...", "nl": "..." }.
import texts from '../../content/texts.json';
import trainings from '../../content/trainings.json';
import dates from '../../content/dates.json';
import projects from '../../content/projects.json';
import news from '../../content/news.json';
import team from '../../content/team.json';

const { lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const media = (p) => (!p ? '' : p.startsWith('http') ? p : base + p);
const T = (v) => (v && typeof v === 'object' ? v[lang] || v.en || '' : v || '');
const t = texts;
const shown = (list) => list.filter((x) => x.visible !== false);
const openTrainings = shown(trainings).filter((x) => x.kind !== 'In-company');
const companyTrainings = shown(trainings).filter((x) => x.kind === 'In-company');
const lines = (s) => (s || '').split('\n').filter(Boolean);
const enUrl = `${base}/a/en/`;
const nlUrl = `${base}/a/nl/`;

// Fixed interface words; editors change the content, not these.
const UI = {
  en: {
    title: 'Perspectivity · Concept A: Calm', skip: 'Skip to content', home: 'Perspectivity, back to top',
    mainNav: 'Main', langNav: 'Language', concepts: 'Concepts',
    menu: { work: 'What we do', navigator: 'Navigator', tools: 'Tools', training: 'Training', projects: 'Projects', team: 'Who we are', contact: 'Contact' },
    ctaWork: 'What we do', ctaTraining: 'Our training courses',
    navAlt: 'The Complexity Navigator: an egg of building blocks',
    navBlocks: 'The building blocks include backbone, responsive leadership, reinforcing actions, involvement of all, urgency for change, vital connections, adaptive learning and shared ambitions.',
    download: 'Download the Navigator', visitSprockler: 'Visit sprockler.com', visitChallenge: 'Visit the Challenge', external: ' (external site)',
    tba: 'Date to be announced', openTr: 'Open trainings', inCompany: 'In-company', partner: 'Partner:', publications: 'Publications',
    newsletter: 'Newsletter', name: 'Name', email: 'Email', subscribe: 'Subscribe', privacy: 'Privacy statement',
    logoAlt: 'Perspectivity, for the love of complexity',
    words: { 'In person': 'In person', Online: 'Online', Hybrid: 'Hybrid', News: 'News', Blog: 'Blog' },
  },
  nl: {
    title: 'Perspectivity · Concept A: Calm (Nederlands)', skip: 'Naar de inhoud', home: 'Perspectivity, terug naar boven',
    mainNav: 'Hoofdmenu', langNav: 'Taal', concepts: 'Concepten',
    menu: { work: 'Wat we doen', navigator: 'Navigator', tools: 'Tools', training: 'Training', projects: 'Projecten', team: 'Wie we zijn', contact: 'Contact' },
    ctaWork: 'Wat we doen', ctaTraining: 'Onze trainingen',
    navAlt: 'De Complexity Navigator: een ei van bouwstenen',
    navBlocks: 'Tot de bouwstenen horen onder meer backbone, responsive leadership, reinforcing actions, involvement of all, urgency for change, vital connections, adaptive learning en shared ambitions.',
    download: 'Download de Navigator', visitSprockler: 'Naar sprockler.com', visitChallenge: 'Naar de Challenge', external: ' (externe site)',
    tba: 'Datum volgt', openTr: 'Open trainingen', inCompany: 'In-company', partner: 'Partner:', publications: 'Publicaties',
    newsletter: 'Nieuwsbrief', name: 'Naam', email: 'E-mail', subscribe: 'Inschrijven', privacy: 'Privacyverklaring',
    logoAlt: 'Perspectivity, for the love of complexity',
    words: { 'In person': 'Op locatie', Online: 'Online', Hybrid: 'Hybride', News: 'Nieuws', Blog: 'Blog' },
  },
};
const u = UI[lang];
const word = (w) => u.words[w] || w;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{u.title}</title>
<link rel="alternate" hreflang="en" href={enUrl}>
<link rel="alternate" hreflang="nl" href={nlUrl}>
<link rel="icon" href={`${base}/assets/person-red.png`}>
<link rel="stylesheet" href={`${base}/assets/tokens.css`}>
<style is:global>
  body{background:#fff}
  /* Header */
  .top{--menu-bg:#fff;position:sticky;top:0;z-index:50;background:rgba(255,255,255,.96);border-bottom:var(--dashed)}
  .top .wrap{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:76px}
  .top img{height:34px;width:auto}
  .menu{display:flex;gap:28px;list-style:none;margin:0;padding:0;font-family:var(--font-display);font-weight:500;font-size:15px}
  .menu a{text-decoration:none;padding:10px 0}
  .menu a:hover{color:var(--p-red);text-decoration:underline;text-underline-offset:6px}
  .lang{font-family:var(--font-display);font-weight:700;font-size:14px;display:flex;gap:2px}
  .lang a{text-decoration:none;padding:10px 8px}
  .lang a[aria-current]{color:var(--p-red)}
  @media (max-width:900px){.menu{display:none}}

  section{padding:var(--space-10) 0}
  .rule{border:0;border-top:var(--dashed);margin:0}

  /* Hero */
  .hero{padding:var(--space-11) 0 var(--space-10)}
  .hero .wrap{display:grid;grid-template-columns:1.4fr .6fr;gap:var(--space-9);align-items:end}
  .hero h1{font-size:var(--fs-display);color:var(--p-red)}
  .hero .lead{font-size:var(--fs-lead);max-width:var(--measure);margin:var(--space-7) 0}
  .hero .actions{display:flex;gap:12px;flex-wrap:wrap}
  .hero .puppet{width:100%;max-width:240px;justify-self:end}
  @media (max-width:800px){.hero .wrap{grid-template-columns:1fr}.hero .puppet{max-width:140px;justify-self:start;order:-1}}

  /* Section heads */
  .head{display:grid;grid-template-columns:280px 1fr;gap:var(--space-8);margin-bottom:var(--space-8)}
  .head .eyebrow{color:var(--p-red);padding-top:12px}
  .head h2{font-size:var(--fs-title-2)}
  .head p{max-width:var(--measure);margin:var(--space-4) 0 0}
  @media (max-width:800px){.head{grid-template-columns:1fr;gap:var(--space-3)}}

  /* Services */
  .three{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-7);margin-left:calc(280px + var(--space-8))}
  .three article{border-top:var(--dashed);padding-top:var(--space-5)}
  .three h3{font-family:var(--font-display);font-weight:700;font-size:20px;line-height:1.25;margin:0 0 var(--space-3)}
  .three p{margin:0;color:var(--p-ink-2)}
  @media (max-width:1000px){.three{margin-left:0}}
  @media (max-width:760px){.three{grid-template-columns:1fr}}

  /* Navigator band */
  .nav-band{background:var(--p-lightbeige)}
  .nav-band .wrap{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-9);align-items:center}
  .nav-band img{width:100%;max-width:420px;margin:0 auto}
  .nav-band .wrap>*{min-width:0}
  .nav-band h2{font-size:var(--fs-title-2);margin:var(--space-3) 0 var(--space-5)}
  .nav-band .subtitle{font-size:var(--fs-subtitle);margin-bottom:var(--space-5)}
  @media (max-width:800px){.nav-band .wrap{grid-template-columns:1fr}}

  /* Trainings */
  .dates{list-style:none;margin:0 0 var(--space-8) calc(280px + var(--space-8));padding:0}
  .dates li{display:grid;grid-template-columns:260px 1fr auto;gap:var(--space-6);align-items:baseline;padding:var(--space-5) 0;border-bottom:var(--dashed)}
  .dates li:first-child{border-top:var(--dashed)}
  .dates .when{font-family:var(--font-display);font-weight:700;color:var(--p-red)}
  .dates .what{font-family:var(--font-display);font-weight:500;font-size:20px}
  .dates .how{font-size:var(--fs-small);color:var(--p-ink-3)}
  @media (max-width:1000px){.dates{margin-left:0}.dates li{grid-template-columns:1fr}}
  .cols{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-8);margin-left:calc(280px + var(--space-8))}
  .cols ul{list-style:none;margin:0;padding:0}
  .cols li{padding:var(--space-3) 0;border-bottom:1px solid var(--p-line)}
  .cols li strong{font-family:var(--font-display);font-weight:700;display:block}
  .cols li span{font-size:var(--fs-small);color:var(--p-ink-2)}
  @media (max-width:1000px){.cols{margin-left:0;grid-template-columns:1fr}}
  .note{font-size:var(--fs-small);color:var(--p-ink-3);margin:var(--space-6) 0 0 calc(280px + var(--space-8))}
  @media (max-width:1000px){.note{margin-left:0}}

  /* Projects */
  .projects article>*{min-width:0}
  .projects article{display:grid;grid-template-columns:280px 1fr;gap:var(--space-8);padding:var(--space-7) 0;border-top:var(--dashed)}
  .projects .partner{font-family:var(--font-display);font-weight:700;font-size:var(--fs-small);text-transform:uppercase;letter-spacing:.06em;color:var(--p-red)}
  .projects h3{font-family:var(--font-display);font-weight:500;font-size:var(--fs-title-3);line-height:1.15;margin:0 0 var(--space-3)}
  .projects p{margin:0;max-width:var(--measure)}
  @media (max-width:800px){.projects article{grid-template-columns:1fr;gap:var(--space-2)}}

  /* Quote */
  .quote-band{background:var(--p-lightbeige);text-align:center}
  .quote-band .quote{color:var(--p-red-text)}
  .quote-band blockquote{margin:0 auto;max-width:880px}
  .quote-band cite{display:block;margin-top:var(--space-5);font-style:normal;font-family:var(--font-display);font-weight:700;font-size:var(--fs-small)}

  /* Stories */
  .stories{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-7)}
  .stories a{text-decoration:none;display:block;border-top:var(--dashed);padding-top:var(--space-5)}
  .stories a:hover h3{text-decoration:underline;text-underline-offset:5px}
  .stories h3{font-family:var(--font-display);font-weight:700;font-size:20px;line-height:1.25;margin:var(--space-2) 0}
  .stories p{margin:0;color:var(--p-ink-2);font-size:16px}
  @media (max-width:800px){.stories{grid-template-columns:1fr}}

  /* Team */
  .team{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:var(--space-7) var(--space-6)}
  .team figure{margin:0}
  .team .ph{aspect-ratio:1;background:var(--p-lightbeige);overflow:hidden}
  .team .ph img{width:100%;height:100%;object-fit:cover}
  .team .ph.none{display:grid;place-items:center}
  .team .ph.none img{width:40%;height:auto;object-fit:contain}
  .team figcaption{margin-top:var(--space-3)}
  .team strong{font-family:var(--font-display);font-weight:700;display:block;line-height:1.25}
  .team span{font-size:var(--fs-small);color:var(--p-ink-3)}

  /* Toolbox */
  .tools{display:flex;flex-wrap:wrap;gap:8px;margin-left:calc(280px + var(--space-8))}
  .tools span,.tools a{font-family:var(--font-display);font-weight:500;font-size:15px;padding:8px 16px;border:1px solid var(--p-line);border-radius:999px;text-decoration:none}
  .tools a{border-color:var(--p-red);color:var(--p-red);font-weight:700}
  .tools a:hover{background:var(--p-red);color:#fff}
  @media (max-width:1000px){.tools{margin-left:0}}

  /* Newsletter + contact */
  .contact{background:var(--p-red);color:#fff}
  .contact .wrap{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-9)}
  .contact h2{font-size:var(--fs-title-2)}
  .contact p{max-width:46ch}
  .contact form{display:grid;gap:var(--space-4);align-content:start}
  .contact .field label{color:#fff}
  .contact .field input{border-color:#fff}
  .contact .btn-light{background:#fff;color:var(--p-red)}
  .contact .btn-light:hover{background:var(--p-black);color:#fff}
  .contact address{font-style:normal;margin-top:var(--space-6)}
  .contact :focus-visible{outline-color:#fff}
  @media (max-width:800px){.contact .wrap{grid-template-columns:1fr}}

  footer{padding:var(--space-8) 0;font-size:var(--fs-small);color:var(--p-ink-3)}
  footer .wrap{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap}
  footer img{height:26px;width:auto}
  .tool-pair{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-8);margin-left:calc(280px + var(--space-8))}
  .tool-pair article{border-top:var(--dashed);padding-top:var(--space-6)}
  .tool-pair h3{font-family:var(--font-display);font-weight:500;font-size:var(--fs-title-3);line-height:1.15;margin:0 0 var(--space-4)}
  .tool-pair p{margin:0 0 var(--space-6)}
  .tool-pair .tool-logo{width:240px;height:auto;margin:0 0 var(--space-5)}
  @media (max-width:1000px){.tool-pair{margin-left:0}}
  @media (max-width:760px){.tool-pair{grid-template-columns:1fr}}
</style>
</head>
<body>
<a class="skip" href="#main">{u.skip}</a>

<header class="top">
  <div class="wrap">
    <a href="#top" aria-label={u.home}><img src={`${base}/assets/logo-red.png`} alt="Perspectivity"></a>
    <nav aria-label={u.mainNav}>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu">Menu</button>
      <ul class="menu" id="menu">
        <li><a href="#work">{u.menu.work}</a></li>
        <li><a href="#navigator">{u.menu.navigator}</a></li>
        <li><a href="#tools">{u.menu.tools}</a></li><li><a href="#training">{u.menu.training}</a></li>
        <li><a href="#projects">{u.menu.projects}</a></li>
        <li><a href="#team">{u.menu.team}</a></li>
        <li><a href="#contact">{u.menu.contact}</a></li>
      </ul>
    </nav>
    <nav class="lang" aria-label={u.langNav}><a href={enUrl} lang="en" hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN<span class="sr-only"> English</span></a><a href={nlUrl} lang="nl" hreflang="nl" aria-current={lang === 'nl' ? 'true' : undefined}>NL<span class="sr-only"> Nederlands</span></a></nav>
  </div>
</header>

<main id="main">
  <section class="hero" id="top">
    <div class="wrap">
      <div>
        <h1 class="title">{T(t.hero.title)}</h1>
        <p class="lead">{T(t.hero.lead)}</p>
        <div class="actions">
          <a class="btn btn-primary" href="#work">{u.ctaWork}</a>
          <a class="btn btn-outline" href="#training">{u.ctaTraining}</a>
        </div>
      </div>
      <img class="puppet" src={`${base}/assets/person-red.png`} alt="">
    </div>
  </section>

  <hr class="rule">

  <section id="work">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">{T(t.work.label)}</p>
        <div>
          <h2 class="title">{T(t.work.title)}</h2>
          <p>{T(t.work.intro)}</p>
        </div>
      </div>
      <div class="three">
        {t.work.services.map((x) => (
          <article>
            <h3>{T(x.title)}</h3>
            <p>{T(x.text)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="nav-band" id="navigator">
    <div class="wrap">
      <img src={`${base}/assets/navigator.png`} alt={u.navAlt} aria-describedby="nav-blocks">
      <p class="sr-only" id="nav-blocks">{u.navBlocks}</p>
      <div>
        <p class="eyebrow" style="color:var(--p-red-text)">{T(t.navigator.label)}</p>
        <h2 class="title">{T(t.navigator.title)}</h2>
        <p class="subtitle" style="color:var(--p-red-text)">{T(t.navigator.subtitle)}</p>
        <p>{T(t.navigator.text)}</p>
        <a class="btn btn-primary" href="#">{u.download}</a>
      </div>
    </div>
  </section>

  <section id="tools" class="tools-band">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">{T(t.tools.label)}</p>
        <div><h2 class="title">{T(t.tools.title)}</h2>
        <p>{T(t.tools.intro)}</p></div>
      </div>
      <div class="tool-pair">
        <article>
          <img class="tool-logo" src={`${base}/assets/sprockler-wordmark.png`} alt="Sprockler" width="900" height="297">
          <h3>{T(t.tools.sprockler.title)}</h3>
          <p>{T(t.tools.sprockler.text)}</p>
          <a class="btn btn-outline" href="https://sprockler.com" rel="noopener">{u.visitSprockler}<span class="sr-only">{u.external}</span></a>
        </article>
        <article>
          <p class="tussenkop" style="color:var(--p-red)">The Perspectivity Challenge</p>
          <h3>{T(t.tools.challenge.title)}</h3>
          <p>{T(t.tools.challenge.text)}</p>
          <a class="btn btn-outline" href="https://perspectivity-challenge.org" rel="noopener">{u.visitChallenge}<span class="sr-only">{u.external}</span></a>
        </article>
      </div>
    </div>
  </section>

  <section id="training">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">{T(t.training.label)}</p>
        <div>
          <h2 class="title">{T(t.training.title)}</h2>
          <p>{T(t.training.intro)}</p>
        </div>
      </div>
      {shown(dates).length > 0 && (
        <ul class="dates">
          {shown(dates).map((x) => (
            <li><span class="when">{T(x.date) || u.tba}</span><span class="what">{T(x.training)}</span><span class="how">{word(x.format)}</span></li>
          ))}
        </ul>
      )}
      <div class="cols">
        <div>
          <p class="tussenkop">{u.openTr}</p>
          <ul>
            {openTrainings.map((x) => <li><strong>{T(x.title)}</strong><span>{T(x.summary)}</span></li>)}
          </ul>
        </div>
        <div>
          <p class="tussenkop">{u.inCompany}</p>
          <ul>
            {companyTrainings.map((x) => <li><strong>{T(x.title)}</strong><span>{T(x.summary)}</span></li>)}
          </ul>
        </div>
      </div>
      <p class="note">{T(t.training.note)}</p>
    </div>
  </section>

  <hr class="rule">

  <section id="projects" class="projects">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">{T(t.projects.label)}</p>
        <h2 class="title">{T(t.projects.title)}</h2>
      </div>
      {projects.map((x) => (
        <article>
          <p class="partner">{u.partner} {T(x.partner)}</p>
          <div><h3>{T(x.title)}</h3>
          <p>{T(x.summary)}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="quote-band">
    <div class="wrap">
      <blockquote>
        <p class="quote">{T(t.quote)}</p>
      </blockquote>
    </div>
  </section>

  <section id="stories">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">{T(t.stories.label)}</p>
        <h2 class="title">{T(t.stories.title)}</h2>
      </div>
      <div class="stories">
        {news.map((x) => (
          <a href="#"><span class="eyebrow" style="color:var(--p-red)">{word(x.kind)}</span><h3>{T(x.title)}</h3><p>{T(x.summary)}</p></a>
        ))}
      </div>
    </div>
  </section>

  <hr class="rule">

  <section id="team">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">{T(t.team.label)}</p>
        <div>
          <h2 class="title">{T(t.team.title)}</h2>
          <p>{T(t.team.intro)}</p>
        </div>
      </div>
      <div class="team" id="team-grid">
        {team.map((p) => (
          <figure><div class={p.photo ? 'ph' : 'ph none'}>{p.photo ? <img class="grey" src={media(p.photo)} alt="" loading="lazy"> : <img src={`${base}/assets/person-red.png`} alt="">}</div>
          <figcaption><strong>{p.name}</strong><span>{T(p.focus)}</span></figcaption></figure>
        ))}
      </div>
    </div>
  </section>

  <section id="toolbox" style="padding-top:0">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">{T(t.toolbox.label)}</p>
        <div><h2 class="title" style="font-size:var(--fs-title-3)">{T(t.toolbox.title)}</h2></div>
      </div>
      <div class="tools">
        <a href="https://sprockler.com" rel="noopener">Sprockler ↗</a>
        <a href="#navigator">Complexity Navigator</a>
        <a href="#">{u.publications}</a>
        {t.toolbox.methods.map((m) => <span>{T(m)}</span>)}
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="wrap">
      <div>
        <h2 class="title">{T(t.contact.title)}</h2>
        <p>{T(t.contact.text)}</p>
        <address>{lines(T(t.contact.address)).map((l) => <>{l}<br></>)}<a href={`mailto:${T(t.contact.email)}`}>{T(t.contact.email)}</a><br>{T(t.contact.phone)}</address>
      </div>
      <form onsubmit="return false" aria-label={u.newsletter}>
        <p class="tussenkop" style="color:#fff">{u.newsletter}</p>
        <div class="field"><label for="a-name">{u.name}</label><input id="a-name" autocomplete="name"></div>
        <div class="field"><label for="a-mail">{u.email}</label><input id="a-mail" type="email" autocomplete="email"></div>
        <div><button class="btn btn-light" type="submit">{u.subscribe}</button></div>
      </form>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <img src={`${base}/assets/logo-payoff-red.png`} alt={u.logoAlt}>
    <span>{T(t.footer)} · <a href="#">{u.privacy}</a></span>
  </div>
</footer>

<nav class="concept-bar" aria-label={u.concepts}><a href={`${base}/`}>All</a><a href={lang === 'nl' ? nlUrl : enUrl} aria-current="page">A</a><a href={`${base}/b/`}>B</a><a href={`${base}/c/`}>C</a></nav>
<script is:inline src={`${base}/assets/site.js`}></script>
</body>
</html>
